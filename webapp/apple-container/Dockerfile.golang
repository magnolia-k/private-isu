# syntax=docker/dockerfile:1
FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
# Apple Container 1.4.1 does not send sources used only by a RUN bind mount.
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 go build -o /bin/server .

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y openssl
ARG UID=10001
RUN adduser --disabled-password --gecos "" --home /nonexistent \
    --shell /sbin/nologin --no-create-home --uid "${UID}" appuser
USER appuser
WORKDIR /home/webapp
COPY --from=build /bin/server /bin/
COPY templates ./templates
ENTRYPOINT ["/bin/server"]
